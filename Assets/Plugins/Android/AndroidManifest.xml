<?xml version="1.0" encoding="utf-8"?>
<!-- Library-side manifest (merged into unityLibrary as the base). Deliberately minimal:
     the previous APK build failed at launcher processMainManifest due to android:label /
     allowBackup collisions with this file. App-identity attributes now live ONLY in
     LauncherManifest.xml, so nothing merges at the application node. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.INTERNET"/>

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application>
        <meta-data android:name="unityplayer.SkipPermissionsDialog" android:value="true" />
    </application>
</manifest>
